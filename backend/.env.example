# Flow Plan 백엔드 환경 설정 예시 — 이 파일을 복사해 .env 로 사용하세요
# cp .env.example .env

# ---- 데이터베이스 (기본: 로컬 SQLite, backend/data/flow_plan.db) ----
DATABASE_URL=sqlite:///./data/flow_plan.db
# 운영 시 예: postgresql+psycopg://user:pass@host:5432/flowplan

# ---- JWT ----
# 운영에서는 반드시 변경
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI Provider (openai | anthropic | clova | gemini | mock) ----
# API Key는 서버에만 저장합니다. 클라이언트에 노출 금지(§43.8)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash